rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'Luisenamorell@gmail.com'; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 2. Products
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidProduct(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidProduct(incoming()) && incoming().updatedAt == request.time && incoming().sku == existing().sku;
      allow delete: if isAdmin();
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.sku is string && data.sku.size() <= 50 &&
             data.name is string && data.name.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.costPrice is number &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2048));
    }

    // 3. Warehouses
    match /warehouses/{warehouseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidWarehouse(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidWarehouse(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isAdmin();

      // 4. Inventory Subcollection
      match /inventory/{productId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidInventory(incoming());
      }

      // 5. Movements Subcollection
      match /inventoryMovements/{movementId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidMovement(incoming()) && incoming().createdAt == request.time;
      }
    }

    function isValidWarehouse(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.type in ['Bodega', 'Camion'] &&
             data.location is string && data.location.size() <= 500;
    }

    function isValidInventory(data) {
      return data.productId is string && data.warehouseId is string &&
             data.quantity is number;
    }

    function isValidMovement(data) {
      return data.productId is string && data.warehouseId is string &&
             data.quantity is number && data.quantity > 0 &&
             data.movementType in ['Entry', 'Exit', 'Transfer', 'Transfer_In', 'Transfer_Out', 'Adjustment'];
    }

    // 6. Global Movements Log (for Dashboard)
    match /movements/{movementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
    
    // Collection Group Queries
    match /{path=**}/inventory/{productId} {
      allow read: if isSignedIn();
    }

    match /{path=**}/inventoryMovements/{movementId} {
      allow read: if isSignedIn();
    }
  }
}
